# Development image: runs the Angular dev server with live reload.
# Source code is bind-mounted at runtime for live updates (see docker-compose.dev.yml).
FROM node:22-alpine

WORKDIR /app

# Copy package manifests and lockfile
COPY package*.json ./

# Install dependencies
RUN npm ci

# Include source so the image also works without a bind mount.
COPY . .

# Expose Angular dev server port
EXPOSE 4200

# Start the dev server, reachable from outside the container,
# proxying /api and /ws to the backend
CMD ["npm", "start", "--", "--host", "0.0.0.0", "--poll", "1000", "--proxy-config", "proxy.conf.mjs"]
